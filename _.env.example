# Copy to .env (local) or add these in Render / Vercel → Environment. NEVER commit the real .env.
DATABASE_URL=
JWT_SECRET=                      # 32+ random characters (openssl rand -hex 48)
MASTER_ADMIN_USERNAME=           # only for the very first admin; remove MASTER_ADMIN_PASSWORD after first login
MASTER_ADMIN_PASSWORD=           # 12+ characters
ADMIN_BOOTSTRAP_SECRET=

# Student_Attendance.html (Firebase) — copy the same values that used to be written inside the HTML
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Optional login lock tuning
LOGIN_MAX_FAILS_ADMIN=5
LOGIN_MAX_FAILS=10
LOGIN_LOCK_MINUTES=15
