# ── Backend (server.js) — set in your host's Environment settings, never commit real values ──
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
JWT_SECRET=                 # 32+ random chars:  openssl rand -hex 48
PII_ENCRYPTION_KEY=         # separate random secret for Aadhaar/PAN encryption
MASTER_ADMIN_USERNAME=
MASTER_ADMIN_PASSWORD=      # 12+ chars
ADMIN_BOOTSTRAP_SECRET=

# ── Frontend build (scripts/generate-firebase-config.js) ──
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
