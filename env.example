# ── WhatsApp (Meta templates) — the ONLY place these values live ─────────────
# Transport: "meta" (Meta Cloud API directly) or "fast2sms" (Fast2SMS WhatsApp gateway). Unset = auto-detect.
WA_PROVIDER=meta
WA_ENABLED=true
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_API_VERSION=v21.0
# Only if you use the Fast2SMS gateway instead of Meta directly:
FAST2SMS_API_KEY=
FAST2SMS_WA_PHONE_NUMBER_ID=
FAST2SMS_WA_VERSION=v26.0

WA_TEMPLATE_LANG=en
WA_DEFAULT_CC=91

# The two core templates shared by EVERY portal
WA_TEMPLATE_OTP=super_admin_auth_otp
WA_TEMPLATE_INFO=anmol_libmatrix_login_info
# Optional: password-less notices (approved / password changed). Leave empty → SMS fallback.
WA_TEMPLATE_NOTICE=

# ── Portal login links put in the INFO message (new portal = just add PORTAL_URL_<NAME>) ──
PORTAL_URL=
PORTAL_URL_INVOICE=
PORTAL_URL_AGENT=
PORTAL_URL_HRMS=
PORTAL_URL_ADMIN=
PORTAL_URL_PFMS=
PORTAL_URL_STUDENT=
