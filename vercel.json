{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "*.html", "public/**", "frontend/**", "dist/**", "static/**",
          "route-mask.js", "security.js", "supabase-portals.js", "account-security.js", "recycle.js", "dv-invoice-module.js",
          "*.css", "*.js", "*.png", "*.jpg", "*.jpeg", "*.gif", "*.svg", "*.ico", "*.webp", "*.avif",
          "*.woff", "*.woff2", "*.ttf", "*.otf", "*.pdf", "*.txt", "*.xml", "*.webmanifest"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "server.js" }
  ]
}
